+/**
+ * A byte an escape wrote (`\x89`, `\351`) that is not part of a UTF-8
+ * character, held in a JS string as the lone low surrogate U+DC00 plus the
+ * byte, as Python's `surrogateescape` holds one. Text never carries a lone
+ * surrogate, so `bytesFromEscapedText` can turn each back into its byte; a
+ * Latin-1 char would be read as the character U+0080..U+00FF and written as
+ * two bytes.
+ */
+export function escapedByte(byte: number): string {
+  return byte < 0x80
+    ? String.fromCharCode(byte)
+    : String.fromCharCode(0xdc00 + byte);
+}
+
+const LONE_ESCAPED_BYTE = /(?<![\ud800-\udbff])[\udc80-\udcff]/;
+
+/**
+ * Output holding bytes `escapedByte` wrote, as the bytes it stands for: each
+ * escaped byte as itself and the text around it as UTF-8. Undefined when it
+ * holds none, so text output stays text.
+ */
+export function bytesFromEscapedText(text: string): ByteString | undefined {
+  if (!LONE_ESCAPED_BYTE.test(text)) {
+    return undefined;
+  }
+  let bytes = "";
+  let run = "";
+  for (const char of text) {
+    const code = char.charCodeAt(0);
+    if (char.length === 1 && code >= 0xdc80 && code <= 0xdcff) {
+      bytes +=
+        latin1FromBytes(encodeUtf8ToBytes(run)) +
+        String.fromCharCode(code - 0xdc00);
+      run = "";
+    } else {
+      run += char;
+    }
+  }
+  return unsafeBytesFromLatin1(bytes + latin1FromBytes(encodeUtf8ToBytes(run)));
