diff --git a/packages/just-bash/src/commands/printf/printf.bytes.test.ts b/packages/just-bash/src/commands/printf/printf.bytes.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/just-bash/src/commands/printf/printf.bytes.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "../../Bash.js";
+
+async function written(command: string): Promise<number[]> {
+  const env = new Bash();
+  const result = await env.exec(`${command} > /out.bin`);
+  expect(result.exitCode).toBe(0);
+  return [...(await env.fs.readFileBuffer("/out.bin"))];
+}
+
+describe("printf writes the bytes its escapes name", () => {
+  it.each<[string, number[]]>([
+    ["\\x89", [0x89]],
+    ["\\x80\\xff\\x90", [0x80, 0xff, 0x90]],
+    ["\\351", [0xe9]],
+    ["\\200\\377", [0x80, 0xff]],
+    ["\\303\\251", [0xc3, 0xa9]],
+    ["\\xc3\\xa9", [0xc3, 0xa9]],
+    ["é\\x89\\n", [0xc3, 0xa9, 0x89, 0x0a]],
+  ])("printf '%s'", async (format, bytes) => {
+    expect(await written(`printf '${format}'`)).toEqual(bytes);
+  });
+
+  it("writes them from %b", async () => {
+    expect(await written("printf '%b' '\\x89\\0351'")).toEqual([0x89, 0xe9]);
+  });
+
+  it("writes the first byte of a character for %c", async () => {
+    expect(await written("printf '%c' é")).toEqual([0xc3]);
+  });
+
+  it("keeps text output as text", async () => {
+    expect(await written("printf '%s\\n' héllo")).toEqual([
+      ...Buffer.from("héllo\n"),
+    ]);
+  });
+
+  it("gives -v the bytes decoded as text", async () => {
+    const env = new Bash();
+    const result = await env.exec("printf -v x '\\303\\251'; echo \"$x\"");
+    expect(result.stdout).toBe("é\n");
+  });
+});
