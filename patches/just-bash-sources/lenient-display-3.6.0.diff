+/** The length of the valid UTF-8 sequence at `i`, or 0 where none starts. */
+function utf8SequenceLength(bytes: Uint8Array, i: number): number {
+  const b0 = bytes[i];
+  if (b0 < 0x80) return 1;
+  const length = b0 >= 0xf0 ? 4 : b0 >= 0xe0 ? 3 : 2;
+  if (b0 < 0xc2 || b0 > 0xf4 || i + length > bytes.length) return 0;
+  for (let k = 1; k < length; k++) {
+    if ((bytes[i + k] & 0xc0) !== 0x80) return 0;
+  }
+  const b1 = bytes[i + 1];
+  // Overlong forms, UTF-16 surrogates, and code points past U+10FFFF.
+  if (
+    (b0 === 0xe0 && b1 < 0xa0) ||
+    (b0 === 0xed && b1 > 0x9f) ||
+    (b0 === 0xf0 && b1 < 0x90) ||
+    (b0 === 0xf4 && b1 > 0x8f)
+  ) {
+    return 0;
+  }
+  return length;
+}
+
+/**
+ * Decode a `ByteString` as UTF-8 for output a person or a model reads: as
+ * `decodeBytesToUtf8`, except that bytes that are not all UTF-8 fall back to
+ * the latin1 view one stray byte at a time rather than as a whole, so
+ * `héllo` followed by a lone 0x89 reads `héllo\u0089`, not `hÃ©llo\u0089`.
+ */
+export function decodeBytesToUtf8Leniently(
+  b: ByteString,
+  maxBytes: number = DEFAULT_MAX_CONVERSION_BYTES,
+): string {
+  const s = b as unknown as string;
+  const strict = decodeBytesToUtf8(b, maxBytes);
+  if (strict !== s) return strict;
+  let out = "";
+  let start = 0;
+  let i = 0;
+  const bytes = new Uint8Array(s.length);
+  for (let k = 0; k < s.length; k++) {
+    const code = s.charCodeAt(k);
+    // Already Unicode text rather than bytes; nothing to decode.
+    if (code > 0xff) return s;
+    bytes[k] = code;
   }
+  while (i < bytes.length) {
+    const length = utf8SequenceLength(bytes, i);
+    if (length > 0) {
+      i += length;
+      continue;
+    }
+    out += strictUtf8Decoder.decode(bytes.subarray(start, i)) + s[i];
+    i += 1;
+    start = i;
+  }
+  return out + strictUtf8Decoder.decode(bytes.subarray(start));
 }
 
