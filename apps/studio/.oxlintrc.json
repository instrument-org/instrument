{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": [
    "**/tailwind-browser.js",
    "**/routeTree.gen.ts",
    "**/*.gen.ts",
    "**/fixtures",
    "**/templates",
    "**/out",
    "**/dist",
    "**/bin",
    "**/coverage",
    "**/components/extend"
  ],
  "jsPlugins": ["oxlint-tailwindcss", "./oxlint-rules.ts"],
  "overrides": [
    {
      // The syntax bans describe the shape of the running app: one
      // TooltipProvider at its root, links that know about tabs, no bare
      // anchors. A test mounts a component without that shell and supplies the
      // pieces itself, and `src/tests` is where that shell comes from.
      "files": ["**/*.test.*", "src/tests/**"],
      "rules": {
        "studio/no-raw-anchor": "off",
        "studio/no-router-link": "off",
        "studio/one-tooltip-provider": "off"
      }
    },
    {
      "files": ["src/client/**", "src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "message": "@instrument-org/merge-generators cannot run on the client",
                "name": "@instrument-org/merge-generators"
              },
              {
                "message": "@instrument-org/workspace/electron cannot run on the client",
                "name": "@instrument-org/workspace/electron"
              },
              {
                "message": "@instrument-org/workspace/for-shim is not intended for the Studio",
                "name": "@instrument-org/workspace/for-shim"
              },
              {
                "message": "@instrument-org/ai-gateway cannot run on the client",
                "name": "@instrument-org/ai-gateway"
              }
            ],
            "patterns": [
              {
                "allowTypeImports": true,
                "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
                "regex": "^@phosphor-icons/react$"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/electron-main/**", "src/electron-preload/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "message": "@instrument-org/workspace/client is only intended for the client",
                "name": "@instrument-org/workspace/client"
              },
              {
                "message": "@instrument-org/ai-gateway/client is only intended for the client",
                "name": "@instrument-org/ai-gateway/client"
              }
            ],
            "patterns": [
              {
                "allowTypeImports": true,
                "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
                "regex": "^@phosphor-icons/react$"
              }
            ]
          }
        ]
      }
    }
  ],
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/client/styles/globals.css"
    }
  },
  "rules": {
    // The phosphor root re-exports every icon module, and importing it
    // evaluates all of them: ~900ms per test file, since each gets its own
    // module registry. A subpath is a leaf. Type-only imports are erased, so
    // they may point anywhere. Repeated in the overrides above, because an
    // override's options replace these rather than merging with them.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "allowTypeImports": true,
            "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
            "regex": "^@phosphor-icons/react$"
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "message": "window.open is not allowed in the Electron app. Use shell.openExternal or ExternalLink component instead.",
        "object": "window",
        "property": "open"
      }
    ],
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "studio/no-raw-anchor": "error",
    "studio/no-router-link": "error",
    "studio/no-transition-colors": "error",
    "studio/one-tooltip-provider": "error",
    "react/error-boundaries": "warn",
    "react/globals": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/static-components": "warn",
    "react/unsupported-syntax": "warn",
    "react/use-memo": "warn",
    "react/void-use-memo": "warn",
    "tailwindcss/enforce-sort-order": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/no-unknown-classes": [
      "error",
      {
        "allowlist": [
          "code-editor",
          "md-editor",
          "md-message-body",
          "pptx-viewer",
          "rpv-root",
          "rpv-stage",
          "rpv-status",
          "toaster"
        ]
      }
    ]
  }
}
