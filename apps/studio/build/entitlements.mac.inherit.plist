<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Helper processes only. These are the Chromium runtime's requirements
         and nothing else: an app-scoped entitlement inherited down here is
         refused on the helper's own signature, which reads as the whole app
         failing to launch. Keep this file to the hardened-runtime keys and put
         anything the provisioning profile grants in entitlements.mac.plist. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Let the bundled Mac helper (the agent's `calendar` and `contacts`
         commands) read and add to Calendar and Reminders, and read Contacts.
         Under the hardened runtime each is refused without its key; with
         it, macOS asks the user once for each. Hardened-runtime keys, not
         ones a profile grants. -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Lets dictation record from the microphone. Chromium captures audio
         in a helper process, so the helpers need it as well as the app.
         Under the hardened runtime audio input is refused without it; with
         it, macOS asks the user once. A hardened-runtime key, not one a
         profile grants. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
