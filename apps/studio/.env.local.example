# Copy to .env.local. Full reference: ../../.agents/env.md

# Platform API. Production gives a fresh clone real sign-in; point it at
# http://localhost:49100 when running the internal repo's API locally.
MAIN_VITE_APP_API_BASE_URL=https://api.tryinstrument.com
# The reports Worker from the internal repo, for sending problem reports.
MAIN_VITE_REPORTS_BASE_URL=http://localhost:49130

# Optional: override skills registry path (default: repo registry/ submodule)
# MAIN_VITE_APP_REGISTRY_DIR_PATH=
