{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { printf '{}'; exit 0; }; bash \"$(dirname \"$d\")/.claude/hooks/worktree-setup.sh\" >&2; printf '{}'",
            "timeout": 600,
            "statusMessage": "Bootstrapping worktree"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { printf '{}'; exit 0; }; bash \"$(dirname \"$d\")/.claude/hooks/worktree-setup.sh\" >&2; printf '{}'",
            "timeout": 600,
            "statusMessage": "Bootstrapping worktree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '{}'; exit 0; }; node \"$d/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '{}'; exit 0; }; node \"$d/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 180,
            "statusMessage": "Formatting dirty files"
          }
        ]
      }
    ]
  }
}
