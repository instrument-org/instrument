coverage/
node_modules/
.tmp/

.env*
!.env.development.example
!.env.local.example

.DS_Store

# Electron
out/
dist/

# Vendored uv binary (downloaded by scripts/download-uv.ts)
resources/uv/

# Document-viewer WASM binaries (copied from node_modules by the main build)
resources/vendor/

# Turbo
.turbo

.eslintcache

# Electron Vite's Temp Files
electron.vite.config*.mjs

# Where the router generator stages routeTree.gen.ts before renaming it into
# place. The rename empties it, so a file left here is a generate run that was
# killed between the two.
.tanstack/

# Dev logs (written by the main process during local development)
.logs/

# Written by the browser test project when a test fails: a screenshot of the
# page, and the attachments the reporter links from its output. Both are
# reproduced by re-running the failure, so neither is worth keeping.
.vitest-attachments/
__screenshots__/

# Written by the smoke test on every run, and uploaded from here as a CI
# artifact rather than read back from the checkout.
smoke-test-screenshots/
