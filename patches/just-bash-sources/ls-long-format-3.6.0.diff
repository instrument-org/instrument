 }
+
+/** Ids to names from a system database such as /etc/passwd, read once. */
+const accountNames = new Map<string, Map<number, string>>();
+
+function namesIn(database: string): Map<number, string> {
+  let names = accountNames.get(database);
+  if (!names) {
+    names = new Map();
+    try {
+      for (const line of fs.readFileSync(database, "utf8").split("\n")) {
+        const [name, , id] = line.split(":");
+        if (name && !name.startsWith("#") && id && /^\d+$/.test(id)) {
+          names.set(Number(id), name);
+        }
+      }
+    } catch {
+      // No database to read; every id shows as its number.
+    }
+    accountNames.set(database, names);
+  }
+  return names;
+}
+
+/** This process's account name, which a directory service may hold apart from /etc/passwd. */
+function ownAccountName(): string | undefined {
+  try {
+    return os.userInfo().username;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * The names `ls -l` shows for a real file's owner and group: this process's
+ * own account by its name, the others from the system's user and group
+ * databases, and an id neither names as its number. None on Windows, whose
+ * files carry no POSIX owner.
+ */
+export function ownerNames(stat: { uid: number; gid: number }): {
+  owner?: string;
+  group?: string;
+} {
+  if (process.platform === "win32") {
+    return {};
+  }
+  const owner =
+    (stat.uid === process.getuid?.() ? ownAccountName() : undefined) ??
+    namesIn("/etc/passwd").get(stat.uid) ??
+    String(stat.uid);
+  const group = namesIn("/etc/group").get(stat.gid) ?? String(stat.gid);
+  return { group, owner };
+}
