{
  "name": "@instrument-org/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared utilities, types, and constants across packages",
  "repository": {
    "type": "git",
    "url": "https://github.com/instrument-org/instrument"
  },
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons.ts",
    "./merge-generators": "./src/merge-generators.ts",
    "./shim": "./src/shim.ts"
  },
  "scripts": {
    "check:lint": "eslint . --max-warnings 0 --cache",
    "check:types": "tsc --noEmit",
    "fix:lint": "eslint . --max-warnings 0 --fix",
    "turbo:check": "turbo run check:types check:lint"
  },
  "dependencies": {
    "lucide-react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@instrument-org/eslint-config": "workspace:*",
    "@instrument-org/typescript-config": "workspace:*",
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
