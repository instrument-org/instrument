{
  "name": "@instrument-org/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Core AI agents, workflow logic, and workspace management",
  "repository": {
    "type": "git",
    "url": "https://github.com/instrument-org/instrument"
  },
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "exports": {
    "./bash-worker": "./src/lib/bash-worker/entry.ts",
    "./client": "./src/client.ts",
    "./drafts": "./src/lib/drafts/index.ts",
    "./electron": "./src/electron.ts",
    "./host-path": "./src/lib/host-path.ts",
    "./layout": "./src/lib/workspace-layout.ts",
    "./mac-apps-server": "./src/lib/mac-apps/main.ts",
    "./work-folders": "./src/lib/work-folders.ts",
    "./fixture-workspaces": "./scripts/lib/fixture-workspaces.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:lint": "oxlint --type-aware",
    "check:types": "tsc --noEmit",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx evals/cli.ts",
    "eval:activity-grouping": "node --disable-warning=ExperimentalWarning --import tsx evals/activity-grouping.ts",
    "eval:chat-titles": "node --disable-warning=ExperimentalWarning --import tsx evals/chat-titles.ts",
    "eval:decision": "node --disable-warning=ExperimentalWarning --import tsx evals/decision/cli.ts",
    "fix:lint": "oxlint --type-aware --fix",
    "script:chatgpt-account-token": "tsx scripts/chatgpt-account-token.ts",
    "script:clt-shim-audit": "cross-env NODE_ENV=development node --import tsx scripts/clt-shim-audit.ts",
    "script:dump-session-transcript": "tsx scripts/dump-session-transcript.ts",
    "script:dump-sessions": "tsx scripts/dump-sessions.ts",
    "script:probe-app-directory": "tsx scripts/probe-app-directory.ts",
    "script:query-chat-db": "tsx scripts/query-chat-db.ts",
    "script:record-fixture-session": "tsx scripts/record-fixture-session.ts",
    "script:refresh-agent-browser-guide": "tsx scripts/refresh-agent-browser-guide.ts",
    "script:refresh-directory-icons": "tsx scripts/refresh-directory-icons.ts",
    "script:stamp-app-catalog": "tsx scripts/stamp-app-catalog.ts",
    "script:sync-directory-registry": "tsx scripts/sync-directory-registry.ts",
    "script:run-bash": "node --import tsx scripts/run-bash.ts",
    "script:run-workspace": "cross-env NODE_ENV=development tsx scripts/run-workspace.ts",
    "script:seed-workspace": "cross-env NODE_ENV=development tsx scripts/seed-workspace.ts",
    "script:try-local-app": "node --import tsx scripts/try-local-app.ts",
    "test": "vitest",
    "test:ci": "cross-env CI=true vitest --maxWorkers=40%",
    "turbo:check": "turbo run check:types check:lint",
    "turbo:check-and-test": "turbo run check:types check:lint test:ci",
    "turbo:check:lint:ci": "cross-env CI=true turbo check:lint",
    "turbo:test": "turbo run test test:ci"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@instrument-org/ai-gateway": "workspace:*",
    "@instrument-org/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@orpc/server": "catalog:",
    "@types/ws": "^8.18.1",
    "@vscode/ripgrep": "^1.18.0",
    "agent-browser": "^0.39.1",
    "ai": "catalog:",
    "date-fns": "^4.1.0",
    "db0": "^0.3.1",
    "diff": "^8.0.3",
    "dugite": "3.2.3",
    "execa": "^9.6.0",
    "ffmpeg-ffprobe-static": "7.1.0-rc.1",
    "hono": "catalog:",
    "ignore": "^7.0.3",
    "image-size": "^2.0.2",
    "isbinaryfile": "^6.0.0",
    "just-bash": "^3.6.0",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "neverthrow": "^8.1.1",
    "node-html-markdown": "^2.0.0",
    "radashi": "^12.6.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "superjson": "^2.2.2",
    "tiny-invariant": "^1.3.3",
    "tokenx": "^2.1.1",
    "ulid": "^3.0.1",
    "unified": "^11.0.5",
    "unstorage": "^1.16.1",
    "ws": "^8.22.0",
    "xstate": "^5.32.5",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.25",
    "@instrument-org/typescript-config": "workspace:*",
    "@t3-oss/env-core": "^0.13.8",
    "@types/json-schema": "^7.0.15",
    "@types/mime-types": "^3.0.1",
    "@types/mock-fs": "^4.13.4",
    "@types/ms": "^2.1.0",
    "@types/node": "catalog:",
    "devtools-protocol": "^0.0.1617013",
    "dotenv": "^16.6.1",
    "jsdom": "^30.1.2",
    "mock-fs": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "undici": "^8.11.2",
    "vitest": "catalog:"
  },
  "optionalDependencies": {},
  "engines": {
    "node": ">=24.22.0"
  }
}
