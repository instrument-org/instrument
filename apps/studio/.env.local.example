# Copy to .env.local. Full reference: ../../.agents/env.md

# Platform API (internal repo at :49100 for local dev)
MAIN_VITE_APP_API_BASE_URL=http://localhost:49100
# Google OAuth for sign-in
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Optional: override skills registry path (default: repo registry/ submodule)
# MAIN_VITE_APP_REGISTRY_DIR_PATH=

# Telemetry (optional)
VITE_DEBUG_TELEMETRY=false
# VITE_POSTHOG_API_HOST=
# VITE_POSTHOG_API_KEY=
