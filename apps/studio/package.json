  "type": "module",
  "main": "./out/main/index.js",
  "files": [],
  "scripts": {
    "build": "electron-vite build",
    "build:analyze": "cross-env ANALYZE_BUILD=true pnpm run build",
    "build:dev": "electron-vite build --mode development --sourcemap",
    "build:env:unsigned": "pnpm run build:vite && electron-builder --config.mac.identity=null --config.win.signAndEditExecutable=false --dir",
    "build:install-app-deps": "electron-builder install-app-deps",
    "build:mac:dev": "pnpm run build:install-app-deps && pnpm run build:dev && electron-builder --mac",
    "build:mac:local": "op run --no-masking --env-file=./.env.build --env-file=./.env.production -- pnpm run build:vite && electron-builder --mac",
    "build:mac:unsigned": "cross-env TARGET_PLATFORM=darwin pnpm run build:vite && electron-builder --mac --config.mac.identity=null --dir",
    "build:test": "electron-vite build --mode test",
    "build:unpack": "pnpm run build:vite && electron-builder --dir",
    "build:vite": "pnpm run build:install-app-deps && pnpm run uv:download && pnpm run build",
    "build:win:unsigned": "cross-env TARGET_PLATFORM=win32 pnpm run build:vite && electron-builder --win --config.win.signAndEditExecutable=false --dir",
    "build:windows:dev": "pnpm run build:install-app-deps && pnpm run build:dev && electron-builder --win",
    "check:lint": "eslint . --max-warnings 0 && oxlint --type-aware",
    "check:types": "tsgo --noEmit",
    "cleanup:releases": "node scripts/cleanup-releases.ts",
    "dev": "cross-env NODE_OPTIONS=--enable-source-maps electron-vite dev --sourcemap",
    "dev:fresh": "cross-env ELECTRON_USE_NEW_USER_FOLDER=true NODE_OPTIONS=--enable-source-maps electron-vite dev --sourcemap",
    "fix:lint": "eslint . --max-warnings 0 --fix && oxlint --type-aware --fix",
    "icons:check": "node scripts/generate-icons.ts --check",
    "icons:generate": "node scripts/generate-icons.ts",
    "postinstall": "install-electron && node scripts/download-uv.ts",
    "routes:generate": "tsr generate",
    "smoke-test": "vitest run --config vitest.smoke.config.ts",
    "start": "electron-vite preview",
    "tag:release:minor": "node scripts/tag-release.ts minor",
    "tag:release:minor:beta": "node scripts/tag-release.ts minor beta",
    "tag:release:patch": "node scripts/tag-release.ts patch",
    "tag:release:patch:beta": "node scripts/tag-release.ts patch beta",
    "tail-logs:dev": "tail -f ~/Library/Logs/Instrument/main.log",
    "tail-logs:prod": "tail -f ~/Library/Application\\ Support/Instrument/logs/main.log",
    "test": "vitest",
    "test:browser": "vitest run --project browser",
    "test:ci": "vitest run --project node --project dom",
    "turbo:check": "turbo run check:types check:lint",
    "turbo:check-and-test": "turbo run check:types check:lint test:ci",
    "turbo:test": "turbo run test test:ci",
    "uv:download": "node scripts/download-uv.ts"
  },
