 export type RegisteredCommandPath = (name: string) => string | undefined;
+
+/**
+ * Told each time the shell runs a command it resolved: a registered command,
+ * one of its bundled commands, or one `resolveExternalCommand` found. Not told
+ * of a name the interpreter answers itself (`cd`, `export`, `command`), of a
+ * function, or of a lookup that runs nothing (`type`, `command -v`, `hash`).
+ */
+export type CommandStartListener = (
+  name: string,
+  info: {
+    /** One of the shell's own commands rather than one the embedder added. */
+    bundled: boolean;
+    /** The path `type` names it by. */
+    path: string;
+    /** A name bash itself implements as a builtin (`echo`, `printf`, `pwd`). */
+    shellBuiltin: boolean;
+  },
+) => void;
 
