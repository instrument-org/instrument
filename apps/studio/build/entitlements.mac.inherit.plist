<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Helper processes only. These are the Chromium runtime's requirements
         and nothing else: an app-scoped entitlement inherited down here is
         refused on the helper's own signature, which reads as the whole app
         failing to launch. Keep this file to the hardened-runtime keys and put
         anything the provisioning profile grants in entitlements.mac.plist. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Lets the bundled EventKit helper (the agent's `calendar` command)
         read and add to Calendar and Reminders. Under the hardened runtime
         EventKit is refused without it; with it, macOS asks the user once
         for each. A hardened-runtime key, not one a profile grants. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
