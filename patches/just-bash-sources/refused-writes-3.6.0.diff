diff --git a/packages/just-bash/src/interpreter/redirections.refused-target.test.ts b/packages/just-bash/src/interpreter/redirections.refused-target.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/just-bash/src/interpreter/redirections.refused-target.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "../Bash.js";
+import { InMemoryFs } from "../fs/in-memory-fs/index.js";
+import type {
+  BufferEncoding,
+  FileContent,
+  WriteFileOptions,
+} from "../fs/interface.js";
+
+/**
+ * A filesystem that refuses writes under `/ro` the way an embedder's
+ * permission layer does: with an errno on the message, on `code`, or both.
+ */
+class RefusingFs extends InMemoryFs {
+  override async writeFile(
+    path: string,
+    content: FileContent,
+    options?: WriteFileOptions | BufferEncoding,
+  ): Promise<void> {
+    this.refuse("open", path);
+    return super.writeFile(path, content, options);
+  }
+
+  override async appendFile(
+    path: string,
+    content: FileContent,
+    options?: WriteFileOptions | BufferEncoding,
+  ): Promise<void> {
+    this.refuse("open", path);
+    return super.appendFile(path, content, options);
+  }
+
+  private refuse(syscall: string, path: string): void {
+    if (path.startsWith("/ro/")) {
+      throw new Error(`EROFS: read-only file system, ${syscall} '${path}'`);
+    }
+    if (path.startsWith("/denied/")) {
+      throw Object.assign(new Error("permission denied"), { code: "EACCES" });
+    }
+  }
+}
+
+const bash = () =>
+  new Bash({ fs: new RefusingFs({ "/ro/.keep": "", "/denied/.keep": "" }) });
+
+describe("redirection to a target the filesystem refuses", () => {
+  it.each([
+    "echo x > /ro/f",
+    "echo x >| /ro/f",
+    "echo x >> /ro/f",
+    "echo x 2> /ro/f",
+    "echo x &> /ro/f",
+    "echo x &>> /ro/f",
+    "echo x >& /ro/f",
+    "echo x 3> /ro/f",
+    "exec > /ro/f",
+    "exec {fd}> /ro/f",
+    "{ echo x; } > /ro/f",
+  ])("fails only the command for %s", async (command) => {
+    const result = await bash().exec(
+      `echo before; ${command}; echo after rc=$?`,
+    );
+    expect(result.stdout).toBe("before\nafter rc=1\n");
+    expect(result.stderr).toBe("bash: /ro/f: Read-only file system\n");
+    expect(result.exitCode).toBe(0);
+  });
+
+  it("reads the errno off code", async () => {
+    const result = await bash().exec("echo x > /denied/f; echo after rc=$?");
+    expect(result.stdout).toBe("after rc=1\n");
+    expect(result.stderr).toBe("bash: /denied/f: Permission denied\n");
+  });
+
+  it("keeps a loop going", async () => {
+    const result = await bash().exec(
+      "for c in a b; do echo $c >> /ro/f; echo iter $c; done",
+    );
+    expect(result.stdout).toBe("iter a\niter b\n");
+    expect(result.stderr).toBe("bash: /ro/f: Read-only file system\n".repeat(2));
+    expect(result.exitCode).toBe(0);
+  });
+
+  it("stops under set -e", async () => {
+    const result = await bash().exec("set -e; echo before; echo x > /ro/f; echo after");
+    expect(result.stdout).toBe("before\n");
+    expect(result.stderr).toBe("bash: /ro/f: Read-only file system\n");
+    expect(result.exitCode).toBe(1);
+  });
+});
