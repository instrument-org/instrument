--- /dev/null
+++ b/packages/just-bash/src/encoding.lenient-display.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "./Bash.js";
+import {
+  decodeBytesToUtf8Leniently,
+  unsafeBytesFromLatin1,
+} from "./encoding.js";
+
+const decode = (bytes: number[]) =>
+  decodeBytesToUtf8Leniently(
+    unsafeBytesFromLatin1(Buffer.from(bytes).toString("latin1")),
+  );
+
+/** Each byte as the latin1 char of the same value. */
+const latin1 = (...bytes: number[]) => String.fromCharCode(...bytes);
+
+describe("decodeBytesToUtf8Leniently", () => {
+  it.each<[string, number[], string]>([
+    ["UTF-8", [...Buffer.from("héllo ✓")], "héllo ✓"],
+    ["a stray byte", [...Buffer.from("héllo "), 0x89], `héllo ${latin1(0x89)}`],
+    ["a cut sequence", [0xe6, 0x97, 0xa5, 0xe6], `日${latin1(0xe6)}`],
+    ["an overlong form", [0xe0, 0x80, 0x80], latin1(0xe0, 0x80, 0x80)],
+    ["a surrogate", [0xed, 0xa0, 0x80], latin1(0xed, 0xa0, 0x80)],
+    ["no high byte", [...Buffer.from("plain")], "plain"],
+  ])("decodes %s", (_, bytes, expected) => {
+    expect(decode(bytes)).toBe(expected);
+  });
+
+  it("leaves Unicode text alone", () => {
+    expect(decodeBytesToUtf8Leniently(unsafeBytesFromLatin1("日"))).toBe(
+      "日",
+    );
+  });
+});
+
+describe("a statement's byte output in the shell's output", () => {
+  it("decodes the UTF-8 around a stray byte", async () => {
+    const env = new Bash();
+    await env.fs.writeFile(
+      "/mixed.bin",
+      new Uint8Array([...Buffer.from("héllo "), 0x89, 0x0a]),
+    );
+    const result = await env.exec("cat /mixed.bin");
+    expect(result.stdout).toBe(`héllo ${latin1(0x89)}\n`);
+  });
+});
