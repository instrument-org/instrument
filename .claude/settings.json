{
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.claude/hooks/worktree-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.claude/hooks/worktree-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
