{
  "name": "@instrument-org/monorepo",
  "version": "0.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/instrument-org/instrument"
  },
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "files": [],
  "scripts": {
    "check-and-test": "turbo run check:actions check:electron-node-version check:format check:unused check:unused-words check:packages:install check:packages:dedupe check:spelling check:md check:types check:lint check:build test:ci --ui tui --continue=dependencies-successful --output-logs errors-only",
    "check-and-test:ci": "turbo run check:actions check:electron-node-version check:unused check:packages:install check:types check:lint check:build test:ci --ui tui --continue=dependencies-successful --output-logs errors-only",
    "check-test-and-push": "pnpm check-and-test && git push",
    "check:actions": "node scripts/check-actions.ts",
    "check:electron-node-version": "node scripts/check-electron-node-version.ts",
    "check:format": "oxfmt --check .",
    "check:lint": "eslint . --max-warnings 0 && oxlint --type-aware scripts *.ts",
    "check:md": "markdownlint-cli2 \"**/*.md\" \".github/**/*.md\"",
    "check:packages:dedupe": "pnpm dedupe --check",
    "check:packages:install": "pnpm install --frozen-lockfile",
    "check:spelling": "cspell --no-progress --gitignore-root . \"**\" \".github/**/*\" \".vscode/**/*\"",
    "check:types": "tsgo --noEmit",
    "check:unused": "knip",
    "check:unused-words": "cspell-check-unused-words",
    "dev:studio": "turbo run dev --filter=@instrument-org/studio --ui tui",
    "fix:format": "oxfmt .",
    "fix:lint": "eslint . --fix && oxlint --type-aware --fix scripts *.ts",
    "fix:unused": "knip --fix",
    "fix:unused-words": "cspell-check-unused-words --fix",
    "scripts:delete-dated-dev-folders": "node scripts/delete-dated-dev-folders.ts",
    "scripts:update-registry": "node scripts/update-registry.ts",
    "test": "vitest",
    "turbo:check:lint:ci": "cross-env CI=true turbo check:lint",
    "turbo:fix:lint": "turbo run fix:lint",
    "update:actions": "actions-up",
    "workspace:seed": "pnpm --filter @instrument-org/workspace run script:seed-workspace"
  },
  "devDependencies": {
    "@cspell/dict-bash": "^4.2.1",
    "@cspell/dict-css": "^4.0.18",
    "@cspell/dict-html": "^4.0.12",
    "@cspell/dict-node": "^5.0.8",
    "@cspell/dict-npm": "^5.2.19",
    "@cspell/dict-typescript": "^3.2.3",
    "@instrument-org/agent-hooks": "github:instrument-org/agent-hooks",
    "@instrument-org/eslint-config": "workspace:*",
    "@instrument-org/typescript-config": "workspace:*",
    "@posthog/cli": "^0.7.10",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "actions-up": "^1.13.0",
    "chrome-devtools-mcp": "^1.6.0",
    "cross-env": "^10.0.0",
    "cspell": "^8.19.4",
    "cspell-check-unused-words": "^1.5.4",
    "eslint": "^9.31.0",
    "knip": "6.23.0",
    "markdownlint": "^0.41.0",
    "markdownlint-cli2": "^0.23.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-tailwindcss": "1.3.4",
    "oxlint-tsgolint": "0.24.0",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "24.15.0"
    }
  },
  "overrides": {
    "@types/node": "24.12.2"
  }
}
