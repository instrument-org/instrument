+
+  it("should load modules through dynamic import() in script mode", async () => {
+    const env = new Bash({
+      javascript: true,
+      files: {
+        "/home/user/data.mjs": "export default 42;\n",
+        "/home/user/main.js":
+          "import('./data.mjs').then((m) => console.log(m.default));\n",
+      },
+    });
+
+    const builtin = await env.exec(
+      `js-exec -c "import('node:fs').then((m) => console.log(typeof m.readFileSync))"`,
+    );
+    expect(builtin.stderr).toBe("");
+    expect(builtin.stdout).toBe("function\n");
+    expect(builtin.exitCode).toBe(0);
+
+    const relative = await env.exec("js-exec /home/user/main.js");
+    expect(relative.stderr).toBe("");
+    expect(relative.stdout).toBe("42\n");
+    expect(relative.exitCode).toBe(0);
+  });
 });
