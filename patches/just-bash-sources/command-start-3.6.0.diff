diff --git a/packages/just-bash/src/interpreter/command-start-listener.test.ts b/packages/just-bash/src/interpreter/command-start-listener.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/just-bash/src/interpreter/command-start-listener.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "../Bash.js";
+import { defineCommand } from "../custom-commands.js";
+import type { CommandStartListener } from "../types.js";
+
+function listen() {
+  const started: string[] = [];
+  const onCommandStart: CommandStartListener = (name, info) => {
+    started.push(
+      `${name}${info.bundled ? " bundled" : ""}${info.shellBuiltin ? " shell-builtin" : ""}`,
+    );
+  };
+  return { onCommandStart, started };
+}
+
+describe("onCommandStart", () => {
+  it("tells each command run, bundled or added, once per run", async () => {
+    const { onCommandStart, started } = listen();
+    const bash = new Bash({
+      customCommands: [
+        defineCommand("mine", async () => ({
+          exitCode: 0,
+          stderr: "",
+          stdout: "",
+        })),
+      ],
+      onCommandStart,
+    });
+    await bash.exec(
+      "echo a | cat; for i in 1 2; do mine; done; command sort </dev/null",
+    );
+    expect(started).toEqual([
+      "echo bundled shell-builtin",
+      "cat bundled",
+      "mine",
+      "mine",
+      "sort bundled",
+    ]);
+  });
+
+  it("is not told of lookups, functions, or what the interpreter answers", async () => {
+    const { onCommandStart, started } = listen();
+    const bash = new Bash({ onCommandStart });
+    await bash.exec(
+      "type cat >/dev/null; command -v sort >/dev/null; hash cat; f() { :; }; f; cd /; export A=1; true",
+    );
+    expect(started).toEqual([]);
+  });
+
+  it("tells a command an external resolver found", async () => {
+    const { onCommandStart, started } = listen();
+    const host = defineCommand("hostcmd", async () => ({
+      exitCode: 0,
+      stderr: "",
+      stdout: "",
+    }));
+    const bash = new Bash({
+      onCommandStart,
+      resolveExternalCommand: async (name) =>
+        name === "hostcmd"
+          ? { command: host, path: "/host/bin/hostcmd" }
+          : undefined,
+    });
+    await bash.exec("hostcmd");
+    expect(started).toEqual(["hostcmd"]);
+  });
+
+  it("runs the command when the listener throws", async () => {
+    const bash = new Bash({
+      onCommandStart: () => {
+        throw new Error("listener failed");
+      },
+    });
+    const result = await bash.exec("echo still");
+    expect(result.stdout).toBe("still\n");
+  });
+});
