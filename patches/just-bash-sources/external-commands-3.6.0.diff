diff --git a/packages/just-bash/src/interpreter/external-command-resolver.test.ts b/packages/just-bash/src/interpreter/external-command-resolver.test.ts
new file mode 100644
index 0000000..ac67e99
--- /dev/null
+++ b/packages/just-bash/src/interpreter/external-command-resolver.test.ts
@@ -0,0 +1,106 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "../Bash.js";
+import { defineCommand } from "../custom-commands.js";
+import { decodeBytesToUtf8 } from "../encoding.js";
+import type { ExternalCommandResolver } from "../types.js";
+
+/** Knows `hostcmd` at `/host/bin/hostcmd` and `/host/bin/tool` by path. */
+function hostResolver(asked: string[] = []): ExternalCommandResolver {
+  const host = defineCommand("hostcmd", async (args, ctx) => ({
+    stdout: `host ${args.join(" ")} cwd=${ctx.cwd} in=${decodeBytesToUtf8(ctx.stdin).trim()}\n`,
+    stderr: "",
+    exitCode: 0,
+  }));
+  return async (name) => {
+    asked.push(name);
+    if (name === "hostcmd") return { command: host, path: "/host/bin/hostcmd" };
+    if (name === "/host/bin/tool" || name === "./tool") {
+      return { command: host, path: "/host/bin/tool" };
+    }
+    // A name the shell already knows, offered anyway: the shell's must win.
+    if (name === "echo" || name === "ls") {
+      return { command: host, path: `/host/bin/${name}` };
+    }
+    return undefined;
+  };
+}
+
+describe("resolveExternalCommand", () => {
+  it("runs a name the shell does not know, with args, cwd and stdin", async () => {
+    const bash = new Bash({
+      cwd: "/tmp",
+      resolveExternalCommand: hostResolver(),
+    });
+    const result = await bash.exec("echo piped | hostcmd a b");
+    expect(result.stdout).toBe("host a b cwd=/tmp in=piped\n");
+    expect(result.exitCode).toBe(0);
+  });
+
+  it("leaves builtins, registered commands and functions their names", async () => {
+    const asked: string[] = [];
+    const bash = new Bash({ resolveExternalCommand: hostResolver(asked) });
+    const result = await bash.exec(
+      "echo hi; f() { echo fn; }; f; ls / >/dev/null; cd /",
+    );
+    expect(result.stdout).toBe("hi\nfn\n");
+    expect(asked).toEqual([]);
+  });
+
+  it("reports a name nobody knows as not found", async () => {
+    const bash = new Bash({ resolveExternalCommand: hostResolver() });
+    const result = await bash.exec("nosuchcmd; echo $?");
+    expect(result.stderr).toBe("bash: nosuchcmd: command not found\n");
+    expect(result.stdout).toBe("127\n");
+  });
+
+  it("is asked for a path before the shell reads the file", async () => {
+    const bash = new Bash({
+      cwd: "/work",
+      files: { "/work/tool": "echo script" },
+      resolveExternalCommand: hostResolver(),
+    });
+    const result = await bash.exec("./tool x; /host/bin/tool y");
+    expect(result.stdout).toBe("host x cwd=/work in=\nhost y cwd=/work in=\n");
+  });
+
+  it("answers command -v, command -V, type and hash", async () => {
+    const bash = new Bash({ resolveExternalCommand: hostResolver() });
+    const result = await bash.exec(
+      [
+        "command -v hostcmd",
+        "command -V hostcmd",
+        "type hostcmd",
+        "type -t hostcmd",
+        "type -P hostcmd",
+        "type -a hostcmd",
+        "command -v /host/bin/tool",
+        "hash hostcmd && hash -t hostcmd",
+        "hostcmd again",
+        "command -v nosuchcmd; echo $?",
+      ].join("\n"),
+    );
+    expect(result.stdout).toBe(
+      [
+        "/host/bin/hostcmd",
+        "hostcmd is /host/bin/hostcmd",
+        "hostcmd is /host/bin/hostcmd",
+        "file",
+        "/host/bin/hostcmd",
+        "hostcmd is /host/bin/hostcmd",
+        "/host/bin/tool",
+        "/host/bin/hostcmd",
+        "host again cwd=/home/user in=",
+        "1",
+        "",
+      ].join("\n"),
+    );
+  });
+
+  it("names a registered command by its own path before the resolver's", async () => {
+    const bash = new Bash({ resolveExternalCommand: hostResolver() });
+    const result = await bash.exec("command -v echo; type ls; type -a ls");
+    expect(result.stdout).toBe(
+      "echo\nls is /usr/bin/ls\nls is /usr/bin/ls\nls is /bin/ls\nls is /host/bin/ls\n",
+    );
+  });
+});
