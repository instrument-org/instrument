coverage/
node_modules/
.tmp/

.env*
!.env.example

# For local signing and notarization
.private_keys/

# misc
.DS_Store
*.pem

# Vitest
*.vitest-temp.json

# Chromium for the browser test project, kept in the workspace on CI so it can
# be cached by path. Locally it lands in the Playwright cache instead.
.playwright-browsers/

# TypeScript
*.tsbuildinfo

# Local folders
*.local/

# Machine-local agent-reference config; personal paths never reach a commit
agent-reference.local.json

# Turbo
.turbo

# Electron Builder
/apps/studio/dist

# ESLint
.eslintcache

# Wrangler, for Knip
.wrangler/

# Editor Files and Workspaces
*.code-workspace
# Committed exception: a personal workspace file, tracked so its editor prefs
# sync across machines. Team-wide settings live in .vscode/settings.json.
!instrument.code-workspace
.idea/

# Cursor (per-user plugin prefs)
.cursor/settings.json

# Agent git worktrees (nested checkouts created by the worktree bootstrap hook)
.claude/worktrees/

# Wireframes: single-use pictures of a proposal, for the conversation that asked
# for one. They reach anyone else as a Notion embed or a screenshot, so the file
# is a scratch artifact rather than history, and one linked from a committed doc
# is a link nobody else can follow. Ask for one to be committed if it should
# outlive the conversation that produced it.
/docs/plans/**/wireframes-*.html
/docs/plans/**/wireframes-index.txt

# What an agent leaves at the checkout root while checking its own work: a
# capture from `studio-drive shot`, whose file argument is resolved against the
# working directory, and a task zip it exported or was handed to read. Named
# for whatever was being looked at, and a capture can hold a real task title or
# a real filename, so neither is something to offer up in a diff. A screenshot
# that belongs to the record goes under `docs/changes/<date>/images/`.
/*.png
/*.zip
/shots/
