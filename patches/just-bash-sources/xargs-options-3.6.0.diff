+
+describe("xargs option forms", () => {
+  it.each([
+    ["-n1", "printf 'a b c\\n' | xargs -n1 echo", "a\nb\nc\n"],
+    ["-n 1", "printf 'a b c\\n' | xargs -n 1 echo", "a\nb\nc\n"],
+    ["-P4 -n1", "printf 'a\\nb\\n' | xargs -P4 -n1 echo", "a\nb\n"],
+    ["-P 4 -n 1", "printf 'a\\nb\\n' | xargs -P 4 -n 1 echo", "a\nb\n"],
+    ["-I{}", "printf 'a\\nb\\n' | xargs -I{} echo {}x", "ax\nbx\n"],
+    ["-I {}", "printf 'a\\nb\\n' | xargs -I {} echo {}x", "ax\nbx\n"],
+    ["-P2 -I{}", "printf 'a\\nb\\n' | xargs -P2 -I{} echo {}x", "ax\nbx\n"],
