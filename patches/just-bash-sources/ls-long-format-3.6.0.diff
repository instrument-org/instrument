+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { Bash } from "../../Bash.js";
+import { ReadWriteFs } from "../../fs/read-write-fs/read-write-fs.js";
+
+describe.skipIf(process.platform === "win32")("ls -l over a real disk", () => {
+  let root: string;
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "ls-real-stat-"));
+    fs.writeFileSync(path.join(root, "run.sh"), "echo hi\n", { mode: 0o755 });
+    fs.chmodSync(path.join(root, "run.sh"), 0o755);
+    const old = new Date(2020, 0, 2, 12, 30);
+    fs.utimesSync(path.join(root, "run.sh"), old, old);
+    fs.symlinkSync("nowhere", path.join(root, "dangling"));
+  });
+
+  afterEach(() => {
+    fs.rmSync(root, { force: true, recursive: true });
+  });
+
+  it("shows each entry's mode, owner, size and time as the disk has them", async () => {
+    const bash = new Bash({ cwd: "/", fs: new ReadWriteFs({ root }) });
+    const result = await bash.exec("ls -la /; ls -l /run.sh");
+    const owner = os.userInfo().username;
+    const lines = result.stdout.split("\n");
+    expect(lines[1]).toMatch(
+      new RegExp(
+        `^drwx[-rwx]{6} 1 ${owner} \\S+ +\\d+ \\w{3} [ \\d]\\d [ \\d:]{5} \\.$`,
+      ),
+    );
+    expect(lines).toEqual(
+      expect.arrayContaining([
+        expect.stringMatching(
+          new RegExp(`^-rwxr-xr-x 1 ${owner} \\S+ +8 Jan  2  2020 run\\.sh$`),
+        ),
+      ]),
+    );
+    expect(lines).toEqual(
+      expect.arrayContaining([
+        expect.stringMatching(
+          new RegExp(`^l[-rwx]{9} 1 ${owner} \\S+ .* dangling$`),
+        ),
+      ]),
+    );
+    expect(lines.at(-2)).toMatch(
+      new RegExp(`^-rwxr-xr-x 1 ${owner} \\S+ +8 Jan  2  2020 /run\\.sh$`),
+    );
+  });
+});
