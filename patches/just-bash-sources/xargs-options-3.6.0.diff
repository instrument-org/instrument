+    ["-s 12", "printf 'aa bb cc\\n' | xargs -s 12 echo", "aa bb\ncc\n"],
+    ["-Estop", "printf 'a stop b\\n' | xargs -Estop echo", "a\n"],
+    ["-E stop", "printf 'a\\nstop\\nb\\n' | xargs -E stop echo", "a\n"],
+    ["-0P2 -n1", "printf 'a b\\0c\\0' | xargs -0P2 -n1 echo", "a b\nc\n"],
+    ["-0 -P2 -n1", "printf 'a\\0b\\0' | xargs -0 -P2 -n1 echo", "a\nb\n"],
+    ["-rn1 empty", "printf '' | xargs -rn1 echo x", ""],
+    [
+      "--max-procs=2 --max-args=1",
+      "printf 'a b\\n' | xargs --max-procs=2 --max-args=1 echo",
+      "a\nb\n",
+    ],
+    [
+      "--max-procs 2 --max-args 1",
+      "printf 'a b\\n' | xargs --max-procs 2 --max-args 1 echo",
+      "a\nb\n",
+    ],
+    ["--replace", "printf 'a\\n' | xargs --replace echo {}x", "ax\n"],
+    ["--replace=%", "printf 'a\\n' | xargs --replace=% echo %x", "ax\n"],
+    ["-i", "printf 'a\\n' | xargs -i echo {}x", "ax\n"],
+    ["--max-lines", "printf 'a b\\nc\\n' | xargs --max-lines echo", "a b\nc\n"],
+    [
+      "--null --delimiter",
+      "printf 'a,b' | xargs --delimiter=, --null -n1 echo",
+      "a,b\n",
+    ],
+    ["-- ends options", "printf 'a\\n' | xargs -- echo -n1", "-n1 a\n"],
+  ])("%s", async (_name, script, stdout) => {
+    expect(await run(script)).toEqual({ stdout, stderr: "", exitCode: 0 });
+  });
+
+  it("reads flags and a value combined in one argument", async () => {
+    expect(await run("printf 'a b\\n' | xargs -trn1 echo")).toEqual({
+      stdout: "a\nb\n",
+      stderr: "echo a\necho b\n",
+      exitCode: 0,
+    });
+  });
+
+  it("takes -I input a whole line at a time", async () => {
+    expect(
+      await run("printf 'a b\\n  c d\\n' | xargs -I{} echo '[{}]'"),
+    ).toEqual({ stdout: "[a b]\n[c d]\n", stderr: "", exitCode: 0 });
+  });
+
+  it("continues a line that ends in a blank for -L", async () => {
+    expect(await run("printf 'a \\nb\\nc\\n' | xargs -L1 echo")).toEqual({
+      stdout: "a b\nc\n",
+      stderr: "",
+      exitCode: 0,
+    });
+  });
+
+  it("lets the last of -n and -L win", async () => {
+    expect(await run("printf 'a b\\nc\\n' | xargs -n1 -L1 echo")).toEqual({
+      stdout: "a b\nc\n",
+      stderr: "",
+      exitCode: 0,
+    });
+  });
+
+  it("leaves option-like words after the command alone", async () => {
+    expect(await run("printf 'a\\n' | xargs echo -n1")).toEqual({
+      stdout: "-n1 a\n",
+      stderr: "",
+      exitCode: 0,
+    });
+  });
+
+  it.each([
+    ["xargs -n0 echo", "xargs: invalid number for -n: '0'\n"],
+    ["xargs -nX echo", "xargs: invalid number for -n: 'X'\n"],
+    ["xargs -Pfoo echo", "xargs: invalid number for -P: 'foo'\n"],
+    ["xargs -L0 echo", "xargs: invalid number for -L: '0'\n"],
+    ["xargs -s x echo", "xargs: invalid number for -s: 'x'\n"],
+    ["xargs -n", "xargs: option requires an argument -- 'n'\n"],
+    ["xargs -0P", "xargs: option requires an argument -- 'P'\n"],
+    ["xargs --max-procs", "xargs: option '--max-procs' requires an argument\n"],
+    [
+      "xargs --null=1 echo",
+      "xargs: option '--null' doesn't allow an argument\n",
+    ],
+    ["xargs -z echo", "xargs: invalid option -- 'z'\n"],
+    ["xargs -0z echo", "xargs: invalid option -- 'z'\n"],
+    ["xargs --bogus echo", "xargs: unrecognized option '--bogus'\n"],
+    [
+      "xargs -s 6 echo",
+      "xargs: argument line too long for -s: cannot fit one argument\n",
+    ],
+  ])("rejects %s", async (script, stderr) => {
+    expect(await run(`printf 'abc\\n' | ${script}`)).toEqual({
+      stdout: "",
+      stderr,
+      exitCode: 1,
+    });
+  });
+});
