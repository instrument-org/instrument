{
  "name": "@instrument-org/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Core AI agents, workflow logic, and workspace management",
  "repository": {
    "type": "git",
    "url": "https://github.com/instrument-org/instrument"
  },
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./electron": "./src/electron.ts",
    "./for-shim": "./src/for-shim.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:lint": "eslint . --max-warnings 0 && oxlint --type-aware",
    "check:types": "tsgo --noEmit",
    "eval": "cross-env NODE_ENV=test NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx evals/cli.ts",
    "fix:lint": "eslint . --max-warnings 0 --fix && oxlint --type-aware --fix",
    "script:clt-shim-audit": "cross-env NODE_ENV=development node --import tsx scripts/clt-shim-audit.ts",
    "script:dump-session-transcript": "tsx scripts/dump-session-transcript.ts",
    "script:dump-sessions": "tsx scripts/dump-sessions.ts",
    "script:query-task-db": "tsx scripts/query-task-db.ts",
    "script:run-bash": "cross-env NODE_ENV=development node --import tsx scripts/run-bash.ts",
    "script:run-workspace": "cross-env NODE_ENV=development tsx scripts/run-workspace.ts",
    "test": "vitest",
    "test:ci": "cross-env CI=true vitest",
    "turbo:check": "turbo run check:types check:lint",
    "turbo:check-and-test": "turbo run check:types check:lint test:ci",
    "turbo:check:lint:ci": "cross-env CI=true turbo check:lint",
    "turbo:test": "turbo run test test:ci"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@hono/node-server": "^2.0.11",
    "@instrument-org/ai-gateway": "workspace:*",
    "@instrument-org/shared": "workspace:*",
    "@netlify/build-info": "^10.0.9",
    "@orpc/server": "catalog:",
    "@parcel/watcher": "2.6.0",
    "@types/ws": "^8.18.1",
    "@vscode/ripgrep": "^1.18.0",
    "@zip.js/zip.js": "^2.8.14",
    "agent-browser": "^0.31.1",
    "ai": "catalog:",
    "date-fns": "^4.1.0",
    "db0": "^0.3.1",
    "detect-port": "^2.1.0",
    "diff": "^8.0.3",
    "dugite": "3.0.0-rc11",
    "execa": "^9.6.0",
    "ffmpeg-static": "^5.3.0",
    "glob": "^13.0.0",
    "hono": "catalog:",
    "ignore": "^7.0.3",
    "image-size": "^2.0.2",
    "isbinaryfile": "^6.0.0",
    "just-bash": "^3.1.0",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "neverthrow": "^8.1.1",
    "node-html-markdown": "^2.0.0",
    "radashi": "^12.6.0",
    "read-pkg": "^9.0.1",
    "superjson": "^2.2.2",
    "tiny-invariant": "^1.3.3",
    "tokenx": "^1.3.0",
    "ulid": "^3.0.1",
    "unstorage": "^1.16.1",
    "ws": "^8.18.3",
    "xstate": "^5.20.1",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@instrument-org/eslint-config": "workspace:*",
    "@instrument-org/typescript-config": "workspace:*",
    "@t3-oss/env-core": "^0.13.8",
    "@types/mime-types": "^3.0.1",
    "@types/mock-fs": "^4.13.4",
    "@types/ms": "^2.1.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "devtools-protocol": "^0.0.1617013",
    "dotenv": "^16.6.1",
    "mock-fs": "^5.5.0",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "undici": "^8.1.0",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-darwin-x64": "2.6.0",
    "@parcel/watcher-linux-arm64-glibc": "2.6.0",
    "@parcel/watcher-linux-arm64-musl": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-linux-x64-musl": "2.6.0",
    "@parcel/watcher-win32-arm64": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
