exports[`the exported text constants > windowCommand 1`] = `
{
  "WAITING_IS_THE_CHATS": "only the chat hands the user a page. End your last message with a needs fence naming the tab and what the user has to do there (sign in, prove they are a person); the chat asks them and sends you on.",
  "WINDOW_COMMAND": {
    "description": "What is in front of the user: this chat's tabs in their window, pages, files, folders and screens alike, each by its tab_ id. \`instrument window list\` names them, which one is in front, and which task is working in each; \`instrument window read <id>\` prints the text of the page in a tab, as the user sees it, signed in where they are. Changing the window is the chat's: \`instrument window show <url or path>...\` opens each in a tab of its own in front, printing the tab's id, which \`agent-browser tab\` takes; \`instrument window show <id>\` brings an open tab forward; \`instrument window show <url or path> --in <id>\` shows something else in a tab; \`instrument window close <id>...\` closes tabs; \`instrument window wait <id> --title '<what to do, a few words>' --reason '<why, one short sentence>'\` hands them a page of this chat's for what only they can do there (sign in, prove they are a person): it comes to the front, a card shows your title and reason with Done and Skip, your turn ends, and their answer wakes you. A path is a file or folder you can read. It opens nothing in the user's own applications and downloads nothing.",
    "name": "instrument window",
    "summary": "What is in front of the user: list, show, read and close this chat's tabs, or ask for one of theirs.",
    "word": "window",
  },
  "WINDOW_IS_THE_CHATS": "only the chat changes the window. To open a page to work in, use \`agent-browser tab new <url>\`; say in your report what the chat should show.",
}
`;

exports[`the exported text constants > workspaceInstructions 1`] = `{}`;

exports[`the exported text constants > xCommand 1`] = `
{
  "X_COMMAND": {
    "description": "Reads X (Twitter) through the user's Grok account, whatever model you run on: \`instrument x search "<words>"\` for posts about something (X's search operators work too), \`--from <handle>\` alone for an account's latest, \`instrument x thread <post url>\` for the conversation around a post, and \`--json\` on either for the posts as data (handle, date, text, url) to pipe or save. It prints the posts themselves, which x.com shows only to a signed-in browser. A shell command, not a skill; \`instrument x --help\` has every flag. When it fails it says why (no Grok account, a usage limit, a refusal), which is what to tell the user.",
    "name": "instrument x",
    "summary": "Search posts on X through the user's Grok account.",
    "word": "x",
  },
}
`;

