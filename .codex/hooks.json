{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.claude/hooks/worktree-setup.sh\"",
            "timeout": 600,
            "statusMessage": "Bootstrapping worktree"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.claude/hooks/worktree-setup.sh\"",
            "timeout": 600,
            "statusMessage": "Bootstrapping worktree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 180,
            "statusMessage": "Formatting dirty files"
          }
        ]
      }
    ]
  }
}
