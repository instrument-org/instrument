{
  "name": "@instrument-org/monorepo",
  "version": "0.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/instrument-org/instrument"
  },
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "files": [],
  "scripts": {
    "check-and-test": "turbo run check:actions check:electron-node-version check:format check:unused check:unused-words check:packages:install check:packages:dedupe check:spelling check:md check:types check:lint check:build test:ci --ui tui --continue=dependencies-successful --output-logs errors-only",
    "check-test-and-push": "pnpm check-and-test && git push",
    "check:actions": "node scripts/check-actions.ts",
    "check:electron-node-version": "node scripts/check-electron-node-version.ts",
    "check:format": "prettier --check .",
    "check:lint": "eslint . --max-warnings 0 --cache",
    "check:md": "markdownlint-cli2 \"**/*.md\" \".github/**/*.md\"",
    "check:packages:dedupe": "pnpm dedupe --check",
    "check:packages:install": "pnpm install --frozen-lockfile",
    "check:spelling": "cspell --no-progress \"**\" \".github/**/*\" \".vscode/**/*\"",
    "check:types": "tsgo --noEmit",
    "check:unused": "knip",
    "check:unused-words": "cspell-check-unused-words",
    "dev:studio": "turbo run dev --filter=@instrument-org/studio --filter=@instrument-org/shim-client --ui tui",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fix:unused": "knip --fix",
    "fix:unused-words": "cspell-check-unused-words --fix",
    "scripts:delete-dated-dev-folders": "node scripts/delete-dated-dev-folders.ts",
    "scripts:update-registry": "node scripts/update-registry.ts",
    "test": "vitest",
    "turbo:fix:lint": "turbo run fix:lint",
    "update:actions": "actions-up"
  },
  "devDependencies": {
    "@cspell/dict-bash": "^4.2.1",
    "@cspell/dict-css": "^4.0.18",
    "@cspell/dict-html": "^4.0.12",
    "@cspell/dict-node": "^5.0.8",
    "@cspell/dict-npm": "^5.2.19",
    "@cspell/dict-typescript": "^3.2.3",
    "@instrument-org/eslint-config": "workspace:*",
    "@instrument-org/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "actions-up": "^1.13.0",
    "cross-env": "^10.0.0",
    "cspell": "^8.19.4",
    "cspell-check-unused-words": "^1.5.4",
    "eslint": "^9.31.0",
    "knip": "^5.75.2",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.21.0",
    "prettier": "^3.6.2",
    "prettier-plugin-curly": "^0.3.2",
    "prettier-plugin-sh": "^0.14.0",
    "prettier-plugin-sql": "^0.19.2",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.1"
  },
  "publishConfig": {
    "provenance": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "24.14.1"
    }
  },
  "overrides": {
    "@types/node": "24.12.2"
  }
}
