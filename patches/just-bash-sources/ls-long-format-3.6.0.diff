+// The permission string ls -l shows for a mode, such as "drwxr-xr-x"
+function formatMode(stat: FsStat): string {
+  const type = stat.isDirectory ? "d" : stat.isSymbolicLink ? "l" : "-";
+  const triplet = (shift: number, special: number, mark: string) => {
+    const bits = stat.mode >> shift;
+    const read = bits & 4 ? "r" : "-";
+    const write = bits & 2 ? "w" : "-";
+    const run = bits & 1;
+    const exec =
+      stat.mode & special ? (run ? mark : mark.toUpperCase()) : run ? "x" : "-";
+    return `${read}${write}${exec}`;
+  };
+  return `${type}${triplet(6, 0o4000, "s")}${triplet(3, 0o2000, "s")}${triplet(0, 0o1000, "t")}`;
+}
+
+// One ls -l line: mode, owner and group where the filesystem knows them,
+// size, and modification time, from the entry's stat
+function formatLongLine(
+  stat: FsStat,
+  name: string,
+  humanReadable: boolean,
+): string {
+  const size = stat.size ?? 0;
+  const sizeStr = humanReadable
+    ? formatHumanSize(size).padStart(5)
+    : String(size).padStart(5);
+  const dateStr = formatDate(stat.mtime ?? new Date(0));
+  return `${formatMode(stat)} 1 ${stat.owner ?? "user"} ${stat.group ?? "user"} ${sizeStr} ${dateStr} ${name}`;
+}
+
