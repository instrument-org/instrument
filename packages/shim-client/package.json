{
  "name": "@instrument-org/shim-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side runtime injected into user apps",
  "keywords": [],
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --configLoader runner",
    "check:build": "pnpm run build",
    "check:lint": "eslint . --max-warnings 0 --cache",
    "check:types": "tsc --noEmit",
    "dev": "vite --configLoader runner --port 48350",
    "fix:lint": "eslint . --max-warnings 0 --fix",
    "turbo:check": "turbo run check:types check:lint"
  },
  "dependencies": {
    "@instrument-org/shared": "workspace:*",
    "@instrument-org/workspace": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "lucide-react": "^0.456.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sprintf-js": "^1.1.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@instrument-org/eslint-config": "workspace:*",
    "@instrument-org/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sprintf-js": "^1.1.4",
    "@vitejs/plugin-react": "catalog:",
    "postcss": "^8.5.3",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
