{
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "cSpell.autoFormatConfigFile": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "json",
    "jsonc",
    "markdown",
    "typescript",
    "typescriptreact",
    "yaml"
  ],
  "eslint.rules.customizations": [
    {
      "rule": "*",
      "severity": "warn"
    }
  ],
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "json",
    "jsonc",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "github-actions-workflow",
    "yaml"
  ],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "files.exclude": {
    ".claude/worktrees": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/.eslintcache": true,
    "**/.git": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/out": true,
    "**/routeTree.gen.ts": true,
    ".claude/worktrees/**": true
  },
  "js/ts.experimental.useTsgo": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  // Can't use useIgnoreFiles because "files to include" still includes those
  // results due to: https://github.com/microsoft/vscode/issues/26574
  "search.exclude": {
    "**/*.code-search": true,
    "**/*.local": true,
    "**/*.pem": true,
    "**/*.tsbuildinfo": true,
    "**/*.vitest-temp.json": true,
    "**/.eslintcache": true,
    "**/.private_keys": true,
    "**/.tmp": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/out": true,
    ".claude/worktrees": true
  },
  "tailwindCSS.classFunctions": ["cn", "tv"],
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore", // Handled by oxlint-tailwindcss
  "typescript.enablePromptUseWorkspaceTsdk": true,
  // Auto-import is where a banned barrel import comes back: the lint rule
  // catches it, but only after it has been written. This keeps the icon
  // package's root out of the suggestions, leaving its per-icon subpaths.
  "typescript.preferences.autoImportSpecifierExcludeRegexes": [
    "^@phosphor-icons/react$"
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "vitest.configSearchPatternInclude": "**/vitest*.config*.{ts,js,mjs,cjs,cts,mts}",
  "yaml.schemas": {
    "https://json.schemastore.org/pnpm-workspace": ["pnpm-workspace.yaml"]
  }
}
