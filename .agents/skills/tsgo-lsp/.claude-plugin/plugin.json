{
  "name": "tsgo-lsp",
  "version": "1.0.0",
  "description": "TypeScript native preview (tsgo) language server",
  "lspServers": {
    "tsgo": {
      "command": "${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsgo",
      "args": ["--lsp", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescript",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
