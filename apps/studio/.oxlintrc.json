{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": [
    "**/tailwind-browser.js",
    "**/routeTree.gen.ts",
    "**/*.gen.ts",
    "**/fixtures",
    "**/out",
    "**/dist",
    "**/bin",
    "**/coverage"
  ],
  "jsPlugins": ["oxlint-tailwindcss", "./oxlint-rules.ts"],
  "overrides": [
    {
      // The syntax bans describe the shape of the running app: one
      // TooltipProvider at its root, links that know about tabs, no bare
      // anchors. A test mounts a component without that shell and supplies the
      // pieces itself, and `src/tests` is where that shell comes from.
      "files": ["**/*.test.*", "src/tests/**"],
      "rules": {
        "studio/no-raw-anchor": "off",
        "studio/no-raw-webview": "off",
        "studio/no-router-link": "off",
        "studio/one-tooltip-provider": "off"
      }
    },
    {
      // The pool is the one owner of the guest elements.
      "files": ["src/client/lib/browser-pool.ts"],
      "rules": {
        "studio/no-raw-webview": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "studio/no-either-command-key": "error",
        "studio/no-os-words": "error",
        "studio/stage-reader-opts-out": "error"
      }
    },
    {
      // The loose timers there were before the rule, by file. A count only
      // falls; a new one takes a disable comment with its reason.
      "files": ["src/client/**"],
      "rules": {
        "studio/no-loose-timers": [
          "error",
          {
            "src/client/components/add-provider/form.tsx": 2,
            "src/client/components/captures/capture-layer.tsx": 2,
            "src/client/components/captures/capture-store.ts": 2,
            "src/client/components/code-editor/code-file-editor.tsx": 1,
            "src/client/components/document-viewers/ask-selection.tsx": 1,
            "src/client/components/document-viewers/data-grid.tsx": 1,
            "src/client/components/document-viewers/docx-viewer.tsx": 2,
            "src/client/components/document-viewers/pdf-viewer.tsx": 1,
            "src/client/components/extend/file-system.tsx": 2,
            "src/client/components/image-viewer.tsx": 1,
            "src/client/components/markdown-editor/block-menu.ts": 2,
            "src/client/components/markdown-editor/editor-session.ts": 2,
            "src/client/components/markdown-editor/html-render.ts": 2,
            "src/client/components/setup/steps/folder.tsx": 1,
            "src/client/components/studio-modals/feedback-dialog.tsx": 1,
            "src/client/components/task/chat-find.tsx": 1,
            "src/client/components/ui/command.tsx": 1,
            "src/client/components/ui/scroll-owner/scroll-owner.ts": 1,
            "src/client/components/window/app-window.tsx": 1,
            "src/client/components/window/bookmarks-submenu.tsx": 1,
            "src/client/components/window/chat-list.tsx": 3,
            "src/client/components/window/chat-row.tsx": 1,
            "src/client/components/window/drag/content-drag.ts": 1,
            "src/client/components/window/drag/drag-layer.tsx": 1,
            "src/client/components/window/drag/session.ts": 2,
            "src/client/components/window/emoji-grid.tsx": 1,
            "src/client/components/window/favorites-drops.ts": 2,
            "src/client/components/window/filter-head.tsx": 1,
            "src/client/components/window/sidebar-drop.ts": 1,
            "src/client/components/window/tab-strip.tsx": 2,
            "src/client/components/window/use-window-commands.ts": 1,
            "src/client/hooks/use-dictation.ts": 1,
            "src/client/lib/browser-pool.ts": 2,
            "src/client/lib/keyboard-loan.ts": 1,
            "src/client/lib/tab-view-state.ts": 2
          }
        ]
      }
    },
    {
      // Tests and the debug pages, and the one file whose subject is when the
      // keyboard may move.
      "files": [
        "**/*.test.*",
        "src/client/routes/debug/**",
        "src/client/lib/keyboard-home.ts"
      ],
      "rules": {
        "studio/no-loose-timers": "off"
      }
    },
    {
      // The table is where those words live, and a test names each system's
      // words to check the right one shows.
      "files": ["src/shared/os-conventions.ts", "**/*.test.*", "src/tests/**"],
      "rules": {
        "studio/no-os-words": "off"
      }
    },
    {
      "files": ["src/electron-main/**"],
      "rules": {
        "studio/no-sync-content-read": "error"
      }
    },
    {
      // Where a file's contents may be read synchronously. The rule cannot
      // tell a file in the synced workspace folder from one on local disk, so
      // this list carries that judgment, a file at a time. A file that reads
      // the synced folder elsewhere keeps the rule, and turns it off by line
      // with the reason instead.
      "files": [
        // Tests, which never run in the app.
        "**/*.test.*",
        // Launch only: migrations and checks that run before any store opens.
        "src/electron-main/lib/machine-data-migration.ts",
        "src/electron-main/lib/settings-migration.ts",
        "src/electron-main/lib/workspace-move.ts",
        // Reads workspace.json only after isDataless says it is downloaded.
        "src/electron-main/lib/workspace-refusal.ts",
        // Local disk: userData, the machine folder, the app's own files and
        // the system's.
        "src/electron-main/lib/app-catalog.ts",
        "src/electron-main/lib/app-session.ts",
        "src/electron-main/lib/diagnostic-log.ts",
        "src/electron-main/lib/launch-overrides.ts",
        "src/electron-main/lib/model-settings.ts",
        "src/electron-main/lib/main-thread-freezes.ts",
        "src/electron-main/lib/problem-reports.ts",
        "src/electron-main/lib/register-crash-diagnostics.ts",
        "src/electron-main/lib/setup-dbus-env.ts",
        "src/electron-main/lib/setup-state.ts",
        "src/electron-main/lib/update-bridge.ts",
        "src/electron-main/lib/update-velopack.ts",
        "src/electron-main/lib/update.ts",
        "src/electron-main/lib/updater-cache.ts",
        "src/electron-main/page-editor/sessions.ts",
        "src/electron-main/stores/workspace/kept-state.ts",
        "src/electron-main/stores/workspace/session.ts",
        // Synchronous on purpose: readWorkspaceIdentity has about fifteen
        // synchronous callers, mostly launch and move code, and the launch
        // reads the open workspace's workspace.json first. The rest of its
        // reads are pid files in the machine folder.
        "src/electron-main/lib/workspaces.ts",
        // Reads the synced workspace, synchronously for now: readSetupFacts,
        // its one caller, is synchronous into setup. It reads the first 16 KB
        // of each chat's logs once per process, and stops at the first sign.
        "src/electron-main/lib/tested-before.ts"
      ],
      "rules": {
        "studio/no-sync-content-read": "off"
      }
    },
    {
      // The code that runs in the window. An import only for its types is erased.
      "files": ["src/client/**", "src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "message": "@instrument-org/merge-generators cannot run on the client",
                "name": "@instrument-org/merge-generators"
              },
              {
                "message": "@instrument-org/workspace/electron cannot run on the client",
                "name": "@instrument-org/workspace/electron"
              },
              {
                "message": "@instrument-org/workspace/for-shim is not intended for the Studio",
                "name": "@instrument-org/workspace/for-shim"
              },
              {
                "message": "@instrument-org/ai-gateway cannot run on the client",
                "name": "@instrument-org/ai-gateway"
              }
            ],
            "patterns": [
              {
                "allowTypeImports": true,
                "message": "Node's modules do not run in the window: the build makes each an empty object, which throws where it is used. Do it in the main process, behind an RPC route.",
                "regex": "^(node:.+|(assert|async_hooks|buffer|child_process|cluster|crypto|dgram|dns|events|fs|http|http2|https|inspector|module|net|os|path|perf_hooks|process|readline|stream|string_decoder|timers|tls|tty|url|util|v8|vm|worker_threads|zlib)(/.+)?)$"
              },
              {
                "allowTypeImports": true,
                "message": "Electron and the main process do not run in the window. Reach them through an RPC route, and put what both sides use in src/shared.",
                "regex": "^(electron(/.+)?|(@|\\.\\.?(/\\.\\.)*)/electron-(main|preload)(/.+)?)$"
              },
              {
                "allowTypeImports": true,
                "group": [
                  "@instrument-org/workspace/*",
                  "!@instrument-org/workspace/client",
                  "!@instrument-org/workspace/report-outline"
                ],
                "message": "This entry of @instrument-org/workspace is not meant for the window. Use @instrument-org/workspace/client; to allow another that imports no Node module, list it beside report-outline."
              },
              {
                "allowTypeImports": true,
                "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
                "regex": "^@phosphor-icons/react$"
              },
              {
                "message": "Import the function from its own module -- `date-fns/format`, not the package root. The root evaluates every function there is.",
                "regex": "^date-fns$"
              }
            ]
          }
        ]
      }
    },
    {
      // Tests run in Node, so they may import it and the main process. The rest
      // repeats the override above, whose options this replaces.
      "files": ["src/client/**/*.test.*", "src/shared/**/*.test.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "message": "@instrument-org/merge-generators cannot run on the client",
                "name": "@instrument-org/merge-generators"
              },
              {
                "message": "@instrument-org/workspace/electron cannot run on the client",
                "name": "@instrument-org/workspace/electron"
              },
              {
                "message": "@instrument-org/workspace/for-shim is not intended for the Studio",
                "name": "@instrument-org/workspace/for-shim"
              },
              {
                "message": "@instrument-org/ai-gateway cannot run on the client",
                "name": "@instrument-org/ai-gateway"
              }
            ],
            "patterns": [
              {
                "allowTypeImports": true,
                "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
                "regex": "^@phosphor-icons/react$"
              },
              {
                "message": "Import the function from its own module -- `date-fns/format`, not the package root. The root evaluates every function there is.",
                "regex": "^date-fns$"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/electron-main/**", "src/electron-preload/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "message": "@instrument-org/workspace/client is only intended for the client",
                "name": "@instrument-org/workspace/client"
              },
              {
                "message": "@instrument-org/ai-gateway/client is only intended for the client",
                "name": "@instrument-org/ai-gateway/client"
              },
              {
                "importNames": ["publisher", "workspacePublisher"],
                "message": "The workspace's event bus is its own: hear it through appListChanges or sessionEnds, and tell it through appChanged, so the workspace can leave the main process.",
                "name": "@instrument-org/workspace/electron"
              }
            ],
            "patterns": [
              {
                "allowTypeImports": true,
                "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
                "regex": "^@phosphor-icons/react$"
              },
              {
                "message": "Import the function from its own module -- `date-fns/format`, not the package root. The root evaluates every function there is.",
                "regex": "^date-fns$"
              }
            ]
          }
        ]
      }
    }
  ],
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/client/styles/globals.css"
    }
  },
  "rules": {
    // The phosphor root re-exports every icon module, and importing it
    // evaluates all of them: ~900ms per test file, since each gets its own
    // module registry. A subpath is a leaf. Type-only imports are erased, so
    // they may point anywhere. Repeated in the overrides above, because an
    // override's options replace these rather than merging with them.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "allowTypeImports": true,
            "message": "Import the icon from its own module -- `@phosphor-icons/react/Check`, not the package root. The root pulls in every icon there is.",
            "regex": "^@phosphor-icons/react$"
          },
          {
            "message": "Import the function from its own module -- `date-fns/format`, not the package root. The root evaluates every function there is.",
            "regex": "^date-fns$"
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "message": "window.open is not allowed in the Electron app. Use shell.openExternal or ExternalLink component instead.",
        "object": "window",
        "property": "open"
      }
    ],
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "studio/no-raw-anchor": "error",
    "studio/no-raw-webview": "error",
    "studio/no-router-link": "error",
    "studio/no-shared-shadow-on-float": "error",
    "studio/no-shell-open-path": "error",
    "studio/no-transition-colors": "error",
    "studio/one-tooltip-provider": "error",
    "react/error-boundaries": "warn",
    "react/globals": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/static-components": "warn",
    "react/unsupported-syntax": "warn",
    "react/use-memo": "warn",
    "react/void-use-memo": "warn",
    "tailwindcss/enforce-sort-order": "warn",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/no-unknown-classes": [
      "error",
      {
        "allowlist": [
          "code-editor",
          "md-editor",
          "md-message-body",
          "media-skin",
          "pptx-viewer",
          "rpv-root",
          "rpv-stage",
          "rpv-status",
          "toaster"
        ]
      }
    ]
  }
}
