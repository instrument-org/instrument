diff --git a/b/packages/just-bash/src/interpreter/pipeline-handoff.test.ts b/packages/just-bash/src/interpreter/pipeline-handoff.test.ts
new file mode 100644
index 0000000..d5e8cf9
--- /dev/null
+++ b/packages/just-bash/src/interpreter/pipeline-handoff.test.ts
@@ -0,0 +1,127 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "../Bash.js";
+import type { Command, ExecResult } from "../types.js";
+
+/**
+ * A producer that hands its stdout over when offered, and a consumer that
+ * takes it, standing in for two native programs joined by an OS pipe.
+ */
+function commands(log: string[]) {
+  const producer: Command = {
+    name: "produce",
+    trusted: true,
+    async execute(args, ctx) {
+      const text = `${args.join(" ")}\n`;
+      const exitCode = Number(ctx.env.get("PRODUCE_STATUS") ?? "0");
+      if (!ctx.offerPipeHandoff) {
+        return { stdout: text, stderr: "", exitCode };
+      }
+      let settled: Promise<ExecResult> | undefined;
+      return {
+        stdout: "",
+        stderr: "",
+        exitCode: 0,
+        pipeHandoff: {
+          token: `t:${text}`,
+          settle(options) {
+            log.push(`settle discard=${options?.discard === true}`);
+            settled ??= Promise.resolve({
+              stdout: options?.discard ? "" : text,
+              stderr: "produce: note\n",
+              exitCode,
+            });
+            return settled;
+          },
+        },
+      };
+    },
+  };
+  const consumer: Command = {
+    name: "consume",
+    trusted: true,
+    acceptsPipeHandoff: (args) => args[0] !== "--bytes",
+    async execute(_args, ctx) {
+      return {
+        stdout: `token=${ctx.stdinHandoff ?? "-"} stdin=${JSON.stringify(
+          ctx.stdin,
+        )}\n`,
+        stderr: "",
+        exitCode: 0,
+      };
+    },
+  };
+  return [producer, consumer];
+}
+
+describe("pipeline handoffs", () => {
+  it("hands the stream to a consumer that takes it", async () => {
+    const log: string[] = [];
+    const bash = new Bash({ customCommands: commands(log) });
+    const result = await bash.exec("produce a | consume; echo ${PIPESTATUS[@]}");
+    expect(result.stdout).toBe('token=t:a\n stdin=""\n0 0\n');
+    expect(result.stderr).toBe("produce: note\n");
+    expect(log).toEqual(["settle discard=true"]);
+  });
+
+  it("gives a builtin the bytes", async () => {
+    const log: string[] = [];
+    const bash = new Bash({ customCommands: commands(log) });
+    const result = await bash.exec("produce b c | cat");
+    expect(result.stdout).toBe("b c\n");
+    expect(log[0]).toBe("settle discard=false");
+  });
+
+  it("gives the bytes to a consumer declining these arguments", async () => {
+    const bash = new Bash({ customCommands: commands([]) });
+    const result = await bash.exec("produce d | consume --bytes");
+    expect(result.stdout).toBe('token=- stdin="d\\n"\n');
+  });
+
+  it("gives the bytes to a redirected, compound, or function stage", async () => {
+    const bash = new Bash({ customCommands: commands([]) });
+    const result = await bash.exec(
+      [
+        "produce e | consume < /dev/null",
+        "produce f | while read x; do echo got $x; done",
+        "f() { cat; }; produce g | f",
+      ].join("\n"),
+    );
+    expect(result.stdout).toBe("token=- stdin=\"\"\ngot f\ng\n");
+  });
+
+  it("reports the producer's status for PIPESTATUS and pipefail", async () => {
+    const bash = new Bash({ customCommands: commands([]) });
+    const result = await bash.exec(
+      "export PRODUCE_STATUS=3; set -o pipefail; produce h | consume >/dev/null; echo $? ${PIPESTATUS[@]}",
+    );
+    expect(result.stdout).toBe("3 3 0\n");
+  });
+
+  it("settles a handoff no stage read", async () => {
+    const log: string[] = [];
+    const bash = new Bash({ customCommands: commands(log) });
+    const result = await bash.exec("produce i | x=1; echo ${PIPESTATUS[@]}");
+    expect(result.stdout).toBe("0 0\n");
+    expect(log).toEqual(["settle discard=true"]);
+  });
+
+  it("hands on the stdout of a stage discarding its stderr, and drops that stderr", async () => {
+    const log: string[] = [];
+    const bash = new Bash({ customCommands: commands(log) });
+    const result = await bash.exec("produce l 2>/dev/null | consume");
+    expect(result.stdout).toBe('token=t:l\n stdin=""\n');
+    expect(result.stderr).toBe("");
+  });
+
+  it("hands the stream to a consumer that redirects its stdout", async () => {
+    const bash = new Bash({ customCommands: commands([]) });
+    const result = await bash.exec("produce m | consume > /tmp/m; cat /tmp/m");
+    expect(result.stdout).toBe('token=t:m\n stdin=""\n');
+  });
+
+  it("offers nothing to a last stage or a redirected one", async () => {
+    const bash = new Bash({ customCommands: commands([]) });
+    const result = await bash.exec("produce j; produce k > /tmp/k | cat; cat /tmp/k");
+    expect(result.stdout).toBe("j\nk\n");
+  });
+});
