{
  "name": "@instrument-org/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared utilities, types, and constants across packages",
  "repository": {
    "type": "git",
    "url": "https://github.com/instrument-org/instrument"
  },
  "author": {
    "name": "Instrument",
    "email": "oss@tryinstrument.com"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-directory": "./src/app-directory.ts",
    "./constants": "./src/constants.ts",
    "./decision-bars": "./src/decision-bars.ts",
    "./dictated-text": "./src/dictated-text.ts",
    "./exceptions": "./src/exceptions/index.ts",
    "./icons": "./src/icons.ts",
    "./merge-generators": "./src/merge-generators.ts",
    "./secrets": "./src/secrets.ts",
    "./skill-mention": "./src/skill-mention.ts",
    "./strip-markdown": "./src/strip-markdown.ts"
  },
  "scripts": {
    "check:lint": "oxlint --type-aware",
    "check:types": "tsc --noEmit",
    "fix:lint": "oxlint --type-aware --fix",
    "test": "vitest",
    "test:ci": "cross-env CI=true vitest --maxWorkers=40%",
    "turbo:check": "turbo run check:types check:lint"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@instrument-org/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
