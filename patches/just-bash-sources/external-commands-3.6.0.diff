+++ b/packages/just-bash/src/interpreter/external-command-resolver.test.ts
@@ -0,0 +1,239 @@
+import { describe, expect, it } from "vitest";
+import { Bash } from "../Bash.js";
+import { defineCommand } from "../custom-commands.js";
+import { decodeBytesToUtf8 } from "../encoding.js";
+import type { ExternalCommandResolver } from "../types.js";
+
+/** Knows `hostcmd` at `/host/bin/hostcmd` and `/host/bin/tool` by path. */
+function hostResolver(asked: string[] = []): ExternalCommandResolver {
+  const host = defineCommand("hostcmd", async (args, ctx) => ({
+    stdout: `host ${args.join(" ")} cwd=${ctx.cwd} in=${decodeBytesToUtf8(ctx.stdin).trim()}\n`,
+    stderr: "",
+    exitCode: 0,
+  }));
+  return async (name) => {
+    asked.push(name);
+    if (name === "hostcmd") return { command: host, path: "/host/bin/hostcmd" };
+    if (name === "/host/bin/tool" || name === "./tool") {
+      return { command: host, path: "/host/bin/tool" };
+    }
+    // A name the shell already knows, offered anyway: the shell's must win.
+    if (name === "echo" || name === "ls") {
+      return { command: host, path: `/host/bin/${name}` };
+    }
+    return undefined;
+  };
+}
+
+describe("resolveExternalCommand", () => {
+  it("runs a name the shell does not know, with args, cwd and stdin", async () => {
+    const bash = new Bash({
+      cwd: "/tmp",
+      resolveExternalCommand: hostResolver(),
+    });
+    const result = await bash.exec("echo piped | hostcmd a b");
+    expect(result.stdout).toBe("host a b cwd=/tmp in=piped\n");
+    expect(result.exitCode).toBe(0);
+  });
+
+  it("leaves builtins, registered commands and functions their names", async () => {
+    const asked: string[] = [];
+    const bash = new Bash({ resolveExternalCommand: hostResolver(asked) });
+    const result = await bash.exec(
+      "echo hi; f() { echo fn; }; f; ls / >/dev/null; cd /",
+    );
+    expect(result.stdout).toBe("hi\nfn\n");
+    expect(asked).toEqual([]);
+  });
+
+  it("reports a name nobody knows as not found", async () => {
+    const bash = new Bash({ resolveExternalCommand: hostResolver() });
+    const result = await bash.exec("nosuchcmd; echo $?");
+    expect(result.stderr).toBe("bash: nosuchcmd: command not found\n");
+    expect(result.stdout).toBe("127\n");
+  });
+
+  it("is asked for a path before the shell reads the file", async () => {
+    const bash = new Bash({
+      cwd: "/work",
+      files: { "/work/tool": "echo script" },
+      resolveExternalCommand: hostResolver(),
+    });
+    const result = await bash.exec("./tool x; /host/bin/tool y");
+    expect(result.stdout).toBe("host x cwd=/work in=\nhost y cwd=/work in=\n");
+  });
+
+  it("answers command -v, command -V, type and hash", async () => {
+    const bash = new Bash({ resolveExternalCommand: hostResolver() });
+    const result = await bash.exec(
+      [
+        "command -v hostcmd",
+        "command -V hostcmd",
+        "type hostcmd",
+        "type -t hostcmd",
+        "type -P hostcmd",
+        "type -a hostcmd",
+        "command -v /host/bin/tool",
+        "hash hostcmd && hash -t hostcmd",
+        "hostcmd again",
+        "command -v nosuchcmd; echo $?",
+      ].join("\n"),
+    );
+    expect(result.stdout).toBe(
+      [
+        "/host/bin/hostcmd",
+        "hostcmd is /host/bin/hostcmd",
+        "hostcmd is /host/bin/hostcmd",
+        "file",
+        "/host/bin/hostcmd",
+        "hostcmd is /host/bin/hostcmd",
+        "/host/bin/tool",
+        "/host/bin/hostcmd",
+        "host again cwd=/home/user in=",
+        "1",
+        "",
+      ].join("\n"),
+    );
+  });
+
+  it("names a registered command by its own path before the resolver's", async () => {
+    const bash = new Bash({ resolveExternalCommand: hostResolver() });
+    const result = await bash.exec("command -v echo; type ls; type -a ls");
+    expect(result.stdout).toBe(
+      "echo\nls is /usr/bin/ls\nls is /usr/bin/ls\nls is /bin/ls\nls is /host/bin/ls\n",
+    );
+  });
+});
+
+describe("registeredCommandPath", () => {
+  const python = defineCommand("py", async (args) => ({
+    stdout: `py ${args.join(" ")}\n`,
+    stderr: "",
+    exitCode: 0,
+  }));
+  const programs = (name: string) =>
+    name === "py" ? "/opt/venv/bin/python" : undefined;
+
+  function realDisk(files: Record<string, string> = {}) {
+    const asked: string[] = [];
+    const resolver = hostResolver(asked);
+    const bash = new Bash({
+      customCommands: [python],
+      cwd: "/home/user",
+      env: { PATH: "/usr/local/bin:/usr/bin:/bin" },
+      files,
+      registeredCommandPath: programs,
+      resolveExternalCommand: async (name, context) =>
+        name === "/usr/local/bin/hosttool"
+          ? resolver("hostcmd", context)
+          : resolver(name, context),
+    });
+    return { asked, bash };
+  }
+
+  it("describes a command with no program as a shell builtin", async () => {
+    const { bash } = realDisk();
+    const result = await bash.exec(
+      [
+        "type ls",
+        "type -t ls",
+        "type -p ls; echo p=$?",
+        "command -v ls",
+        "command -V ls",
+        "hash ls && hash -t ls",
+      ].join("\n"),
+    );
+    expect(result.stdout).toBe(
+      [
+        "ls is a shell builtin",
+        "builtin",
+        "p=0",
+        "ls",
+        "ls is a shell builtin",
+        "",
+      ].join("\n"),
+    );
+    expect(result.stderr).toBe("bash: hash: ls: not found\n");
+  });
+
+  it("describes a command by the program it runs, and still runs the command", async () => {
+    const { bash } = realDisk();
+    const result = await bash.exec(
+      [
+        "type py",
+        "type -t py",
+        "type -p py",
+        "command -v py",
+        "command -V py",
+        "hash py && hash -t py",
+        "py run",
+      ].join("\n"),
+    );
+    expect(result.stdout).toBe(
+      [
+        "py is /opt/venv/bin/python",
+        "file",
+        "/opt/venv/bin/python",
+        "/opt/venv/bin/python",
+        "py is /opt/venv/bin/python",
+        "/opt/venv/bin/python",
+        "py run",
+        "",
+      ].join("\n"),
+    );
+  });
+
+  it("asks registeredCommandPath as trusted host code", async () => {
+    const bash = new Bash({
+      customCommands: [python],
+      defenseInDepth: true,
+      // Host code may read what a script may not, such as the environment.
+      registeredCommandPath: (name) =>
+        name === "py" && process.env.HOME !== ""
+          ? "/opt/venv/bin/python"
+          : undefined,
+    });
+    const result = await bash.exec("command -v py");
+    expect(result.stdout).toBe("/opt/venv/bin/python\n");
+  });
+
+  it("keeps a registered command's name over a program of that name on PATH", async () => {
+    const { asked, bash } = realDisk({
+      "/usr/local/bin/ls": "echo shadow",
+    });
+    const result = await bash.exec(
+      "chmod +x /usr/local/bin/ls; ls / >/dev/null && echo kept; type -a ls",
+    );
+    expect(result.stdout).toBe(
+      "kept\nls is a shell builtin\nls is /host/bin/ls\nls is /usr/local/bin/ls\n",
+    );
+    expect(asked).toEqual(["ls"]);
+  });
+
+  it("asks the resolver for a name before PATH, and offers it a PATH file by its path", async () => {
+    const { bash } = realDisk({
+      "/usr/local/bin/hostcmd": "echo script",
+      "/usr/local/bin/hosttool": "echo script",
+      "/usr/local/bin/plain": "echo plain script",
+    });
+    const result = await bash.exec(
+      [
+        "chmod +x /usr/local/bin/hostcmd /usr/local/bin/hosttool /usr/local/bin/plain",
+        "hostcmd a",
+        "hosttool b",
+        "plain",
+        "command -v hostcmd plain",
+      ].join("\n"),
+    );
+    expect(result.stdout).toBe(
+      [
+        "host a cwd=/home/user in=",
+        "host b cwd=/home/user in=",
+        "plain script",
+        "/host/bin/hostcmd",
+        "/usr/local/bin/plain",
+        "",
+      ].join("\n"),
+    );
+  });
+});
